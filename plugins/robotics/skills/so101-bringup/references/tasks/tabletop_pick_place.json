{
  "robot_id": "my_follower",
  "robot_type": "so101_follower",
  "port": "/dev/tty.usbmodem0000000000",
  "urdf_path": "SO-ARM100/Simulation/SO101/so101_new_calib.urdf",
  "target_frame": "gripper_frame_link",
  "output_dir": "data/stage4",
  "reference_config": "config/reference_scene.json",
  "stage_name": "SO-101 Camera & Lighting Check",
  "camera_setups": {
    "minimal": {
      "description": "Arm + 1 camera (e.g. wrist camera). Sufficient for Stages 0-3 through Stage 3 Hello World.",
      "required_roles": [
        "wrist"
      ]
    },
    "recommended": {
      "description": "Arm + 2 cameras (fixed/overhead + wrist). Required for optional Stage 5 Hand-Eye Calibration and Phase 2 Pick-and-Place.",
      "required_roles": [
        "wrist",
        "overhead"
      ]
    }
  },
  "cameras": {
    "wrist": {
      "name": "USB2.0_CAM1",
      "opencv_index": 0,
      "width": 640,
      "height": 480,
      "fps": 30,
      "fourcc": "MJPG"
    },
    "overhead": {
      "name": "Streaming Camera",
      "opencv_index": 1,
      "width": 1280,
      "height": 720,
      "fps": 30,
      "fourcc": "MJPG"
    },
    "lighting_thresholds": {
      "overhead": {
        "mean_brightness_min": 30.0,
        "mean_brightness_max": 60.0,
        "table_roi_norm": [
          0.3,
          0.05,
          0.9,
          0.85
        ],
        "glare_threshold": 200,
        "max_table_glare_pct": 0.5,
        "blownout_threshold": 235,
        "max_table_blownout_pct": 0.1
      },
      "wrist": {
        "min_peak_brightness": 90,
        "max_global_brightness": 180.0,
        "glare_threshold": 220,
        "max_glare_pct": 1.5,
        "blownout_threshold": 240,
        "max_blownout_pct": 0.5
      }
    },
    "drift_thresholds": {
      "max_brightness_shift": 10.0,
      "max_channel_shift": 12.0,
      "max_patch_mad": 12.0
    }
  },
  "preflight": {
    "max_frame_age_sec": 0.3,
    "num_checks": 8,
    "interval_sec": 0.3
  },
  "recording": {
    "duration_sec": 10.0,
    "target_fps": 30.0,
    "mp4_filename": "so101_overhead_test.mp4",
    "jsonl_filename": "so101_overhead_events.jsonl",
    "mp4_sample_frame": "so101_overhead_mp4_sample.png"
  },
  "check_robot": {
    "calibration_file": "config/my_follower_calibration.json",
    "readonly_snapshot": "data/stage1/motors_readonly.json",
    "output_dir": "data/stage2",
    "preflight": {
      "max_frame_age_sec": 0.3,
      "num_checks": 5,
      "interval_sec": 0.3
    },
    "limits": {
      "max_step_deg": 20.0,
      "r5_hard_max_step_deg": 45.0,
      "max_speed_deg_per_sec": 30.0,
      "r5_hard_max_speed_deg_per_sec": 90.0,
      "joint_margin_deg": 5.0,
      "rest_tolerance_deg": 5.0,
      "hard_z_floor_m": -0.1,
      "control_hz": 20.0
    },
    "modes": {
      "check": {
        "description": "Connect (torque ON), read normalized joint positions (deg / 0-100), record rest pose, and R4 safe torque-off exit."
      },
      "nudge": {
        "description": "Rotate shoulder_pan +5.0 deg and -5.0 deg back to rest with cosine easing (max speed 8.0 deg/s <= 30 deg/s).",
        "joint": "shoulder_pan",
        "delta_deg": 5.0,
        "segment_duration_sec": 1.0
      },
      "abort-test": {
        "description": "Slower shoulder_pan +5.0 deg nudge (max speed 0.175 deg/s, 90s window) to test q + Enter R3 retreat to rest pose.",
        "joint": "shoulder_pan",
        "delta_deg": 5.0,
        "segment_duration_sec": 45.0
      },
      "hello-world": {
        "description": "Stage 3 minimal-setup milestone: move from rest_pose -> 0.0 deg calibration midpoint on 5 body joints -> open and close gripper once -> return to rest_pose while recording video.",
        "segment_duration_sec": 4.0,
        "gripper_duration_sec": 2.0,
        "max_step_deg": 20.0,
        "max_speed_deg_per_sec": 30.0,
        "gripper_open": 75.0,
        "gripper_closed": 10.0
      }
    }
  },
  "marker_detect": {
    "cue1_blue_triangle": {
      "min_b_minus_g": 42,
      "min_g_minus_r": 10,
      "min_b": 70,
      "min_area_px": 14.0,
      "max_area_px": 900.0,
      "min_solidity": 0.45
    },
    "cue2_white_mount_surround": {
      "inner_radius_px": 10,
      "outer_radius_px": 32,
      "white_v_min": 130,
      "white_s_max": 75,
      "min_white_fraction": 0.35
    }
  },
  "table_touchdown": {
    "output_dir": "data/stage5",
    "patch_xy_m": [
      0.2,
      0.0
    ],
    "z_approach_start_m": 0.03,
    "z_descent_start_m": 0.02,
    "z_hard_floor_m": -0.05,
    "step_z_m": 0.003,
    "closed_gripper_pos": 1.0,
    "contact_detection": {
      "min_sag_increase_m": 0.0028,
      "min_load_increase": 110.0,
      "min_stall_steps": 2,
      "stall_z_drop_threshold_m": 0.0006
    },
    "limits": {
      "max_step_deg": 10.0,
      "max_speed_deg_per_sec": 12.0,
      "joint_margin_deg": 5.0,
      "rest_tolerance_deg": 5.0,
      "control_hz": 20.0
    }
  },
  "handeye_calib": {
    "output_dir": "data/stage5",
    "calibration_output": "config/handeye_calibration.json",
    "nominal_z_table_for_dry_run_m": -0.0243,
    "z_clearances_above_table_m": [
      0.035,
      0.065
    ],
    "grid_xy_m": [
      [
        0.155,
        0.02
      ],
      [
        0.155,
        -0.025
      ],
      [
        0.155,
        -0.07
      ],
      [
        0.185,
        -0.07
      ],
      [
        0.185,
        -0.025
      ],
      [
        0.185,
        0.02
      ],
      [
        0.215,
        0.02
      ],
      [
        0.215,
        -0.025
      ],
      [
        0.215,
        -0.07
      ]
    ],
    "closed_gripper_pos": 1.0,
    "limits": {
      "max_step_deg": 10.0,
      "max_speed_deg_per_sec": 15.0,
      "joint_margin_deg": 5.0,
      "rest_tolerance_deg": 5.0,
      "control_hz": 20.0,
      "settle_sec": 0.45
    }
  }
}
